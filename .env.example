# Root-level env file — read by docker-compose.yml itself for ${VAR}
# substitution (Postgres credentials shared between api-gateway and
# agent-orchestrator, and the frontend's build-time API base URL).
# This is separate from each service's own services/*/.env, which holds
# that service's own secrets (GEMINI_API_KEY, GROQ_API_KEY, JWT_SECRET,
# etc.) and is never read by the root compose file directly.
#
# Copy this to .env in the repo root and fill in real values before
# `docker compose up`.

POSTGRES_DB=fireguard
POSTGRES_USER=fireguard
POSTGRES_PASSWORD=replace-with-a-long-random-password

VITE_API_BASE_URL=http://localhost:8090
