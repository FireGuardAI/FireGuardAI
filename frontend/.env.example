#This is for an example, according to the backend URL it should change
# fireguard-api's docker-compose.yml maps its container port 8080 to host port
# 8090 (see fireguard-api/docker-compose.yml), so 8090 is what a browser on the
# host machine needs to reach — not 8080, which is only reachable inside Docker.
VITE_API_BASE_URL=http://localhost:8090