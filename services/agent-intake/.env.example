# Groq LLM — get a free API key at https://console.groq.com/keys
# NEVER commit this file with a real key filled in — it's .gitignored.
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=10.0
GROQ_MAX_RETRIES=3

# Production hardening
INTAKE_RATE_LIMIT=20/minute

# Logging
LOG_LEVEL=INFO
