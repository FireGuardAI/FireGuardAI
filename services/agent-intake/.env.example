# Groq LLM — get a free API key at https://console.groq.com/keys
# NEVER commit this file with a real key filled in — it's .gitignored.
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=10.0
GROQ_MAX_RETRIES=3

# Production hardening
INTAKE_RATE_LIMIT=20/minute
DOCUMENT_RATE_LIMIT=10/minute

# PDF document intake — extracted in memory, never written to disk
DOCUMENT_MAX_PAGES=20
DOCUMENT_MAX_CHARS=60000
UPLOAD_MAX_BYTES=15728640

# Logging
LOG_LEVEL=INFO
