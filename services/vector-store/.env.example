# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_ANONYMIZED_TELEMETRY=FALSE

# Embedding
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Chunking
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# Paths
RAW_DOCUMENTS_DIR=raw_documents
BM25_INDEX_PATH=data/bm25.db

# Logging
LOG_LEVEL=INFO
